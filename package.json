{
	"name": "cpr-blog",
	"description": "blog.custompcrepublic.com \u2014 Custom PC Republic blog, OpenWrt docs/configs and storefront scaffold (Astro on Cloudflare Workers).",
	"dependencies": {
		"@astrojs/cloudflare": "12.6.12",
		"@astrojs/mdx": "4.3.13",
		"@astrojs/rss": "4.0.14",
		"@astrojs/sitemap": "3.6.1",
		"@fontsource/michroma": "^5.3.0",
		"astro": "5.16.9",
		"typescript": "5.9.3"
	},
	"devDependencies": {
		"markdownlint-cli2": "^0.23.3",
		"prettier": "^3.9.9",
		"prettier-plugin-astro": "^1.1.0",
		"wrangler": "4.56.0"
	},
	"engines": {
		"node": ">=22"
	},
	"private": true,
	"scripts": {
		"astro": "astro",
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro build && wrangler dev",
		"deploy": "wrangler deploy",
		"cf-typegen": "wrangler types",
		"typecheck": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint:md": "markdownlint-cli2",
		"sync:docs": "node scripts/sync-github-docs.mjs",
		"check": "npm run build && npm run typecheck && npm run lint:md && wrangler deploy --dry-run"
	},
	"type": "module"
}
