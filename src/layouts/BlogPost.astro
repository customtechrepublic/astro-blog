---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import PromoSlot from "../components/PromoSlot.astro";
import { slugify } from "../lib/content";

type Props = CollectionEntry<"blog">["data"];

const { title, description, pubDate, updatedDate, heroImage, author, category, tags, project } = Astro.props;
---

<BaseLayout title={title} description={description} image={heroImage} type="article">
	<article>
		<header class="post-head">
			<p class="eyebrow">{category}</p>
			<h1>{title}</h1>
			<p class="meta muted">
				<FormattedDate date={pubDate} /> · {author}
				{updatedDate && (
					<span>
						{" "}
						· updated <FormattedDate date={updatedDate} />
					</span>
				)}
				{project && (
					<span>
						{" "}
						· project: <a href={`/projects/${project.id}/`}>{project.id}</a>
					</span>
				)}
			</p>
			{heroImage && <img class="hero" src={heroImage} alt="" width="1200" height="630" />}
		</header>
		<div class="prose">
			<slot />
		</div>
		{tags.length > 0 && (
			<p class="tags">
				{tags.map((t) => (
					<a href={`/blog/tags/${slugify(t)}/`}>#{t}</a>
				))}
			</p>
		)}
	</article>
	<PromoSlot slot="post-footer" />
</BaseLayout>

<style>
	.post-head {
		margin-bottom: 2rem;
	}
	.post-head h1 {
		margin-top: 0.25rem;
	}
	.eyebrow {
		margin: 0;
	}
	.meta {
		font-size: 0.9rem;
	}
	.hero {
		margin-top: 1.5rem;
		box-shadow: var(--glow);
	}
	.tags {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		margin-top: 2rem;
	}
</style>
