---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
---

<BaseLayout title="About" description={`About ${SITE.title}`}>
	<p class="eyebrow">About</p>
	<h1>Custom PC Republic</h1>
	<p class="lede">
		<strong>{SITE.tagline}</strong>
	</p>
	<p>
		<em>Placeholder — replace with the real company story.</em> Custom PC Republic builds
		<strong>custom gaming and workstation PCs</strong> and <strong>secure home networks</strong> powered by
		OpenWrt.
	</p>
	<ul>
		<li>
			<strong>Builds</strong> — hand-assembled, tuned and hardened before they ship.
		</li>
		<li>
			<strong>Networks</strong> — OpenWrt routers with security-first defaults.
		</li>
		<li>
			<strong>Open</strong> — configs, docs and code published on GitHub.
		</li>
	</ul>
	<p>
		<a class="btn" href={SITE.mainSite}>
			Visit custompcrepublic.com
		</a>
	</p>
</BaseLayout>
