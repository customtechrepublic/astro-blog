---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import FormattedDate from "../../../components/FormattedDate.astro";
import { docSlug } from "../../../lib/content";

export async function getStaticPaths() {
	const docs = await getCollection("docs", ({ data }) => data.section === "openwrt");
	const sorted = docs.sort((a, b) => a.data.order - b.data.order);
	return sorted.map((doc) => ({ params: { slug: docSlug(doc.id) }, props: { doc, all: sorted } }));
}

const { doc, all } = Astro.props as { doc: CollectionEntry<"docs">; all: CollectionEntry<"docs">[] };
const { Content } = await render(doc);
const src = doc.data.source;
---

<BaseLayout title={doc.data.title} description={doc.data.description} wide>
	<div class="docs">
		<nav class="side" aria-label="OpenWrt docs">
			<p class="eyebrow">OpenWrt docs</p>
			<ul>
				{all.map((d) => (
					<li>
						<a
							href={`/openwrt/docs/${docSlug(d.id) ?? ""}`}
							aria-current={d.id === doc.id ? "page" : undefined}
						>
							{d.data.title}
						</a>
					</li>
				))}
			</ul>
		</nav>
		<article>
			<h1>{doc.data.title}</h1>
			{src && (
				<p class="source muted">
					📥 Synced from{" "}
					<a href={`https://github.com/${src.repo}/blob/${src.ref}/${src.path}`}>
						{src.repo}/{src.path}
					</a>
					{src.syncedAt && (
						<>
							{" "}
							on <FormattedDate date={src.syncedAt} />
						</>
					)}
				</p>
			)}
			<Content />
		</article>
	</div>
</BaseLayout>

<style>
	.docs {
		display: grid;
		grid-template-columns: 240px minmax(0, 1fr);
		gap: 3rem;
	}
	.side ul {
		list-style: none;
		padding: 0;
		position: sticky;
		top: 90px;
	}
	.side a {
		text-decoration: none;
		color: var(--text-muted);
	}
	.side a[aria-current="page"] {
		color: var(--accent);
		font-weight: 700;
	}
	article h1 {
		margin-top: 0;
	}
	.source {
		font-size: 0.9rem;
	}
	@media (max-width: 820px) {
		.docs {
			grid-template-columns: 1fr;
			gap: 0;
		}
		.side ul {
			position: static;
		}
	}
</style>
