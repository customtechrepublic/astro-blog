---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import ProjectCard from "../components/ProjectCard.astro";
import PromoSlot from "../components/PromoSlot.astro";
import { SITE } from "../consts";
import { getPosts, getProjects } from "../lib/content";
import { getCollection } from "astro:content";

const posts = (await getPosts()).slice(0, 3);
const projects = (await getProjects()).slice(0, 4);
const configs = await getCollection("configs");
---

<BaseLayout wide>
	<section class="hero" slot="hero">
		<div class="hero-inner">
			<p class="eyebrow">blog.custompcrepublic.com</p>
			<h1>
				Custom PC
				<br />
				Republic
			</h1>
			<p class="tagline">{SITE.tagline}</p>
			<p class="lede">
				<strong>Builds</strong>, <strong>OpenWrt router configs</strong> and
				<strong>security-first networking</strong> — straight from the workbench and GitHub.
			</p>
			<p class="ctas">
				<a class="btn" href="/blog">
					Read the blog
				</a>
				<a class="btn ghost" href="/openwrt/configs">
					Pull a config
				</a>
			</p>
		</div>
	</section>

	<div class="section-head">
		<h2>Latest posts</h2>
		<a href="/blog">All posts →</a>
	</div>
	<ul class="grid">
		{posts.map((post) => (
			<li>
				<PostCard post={post} />
			</li>
		))}
	</ul>

	<PromoSlot slot="home" />

	<div class="section-head">
		<h2>In development</h2>
		<a href="/projects">All projects →</a>
	</div>
	<ul class="grid">
		{projects.map((project) => (
			<li>
				<ProjectCard project={project} />
			</li>
		))}
	</ul>

	<div class="section-head">
		<h2>OpenWrt</h2>
		<a href="/openwrt">Docs & configs →</a>
	</div>
	<ul class="grid">
		<li>
			<a class="card" href="/openwrt/docs/">
				<h3>📘 Documentation</h3>
				<p class="muted">Guides plus READMEs pulled live from our GitHub projects.</p>
			</a>
		</li>
		<li>
			<a class="card" href="/openwrt/configs">
				<h3>
					⚙️ {configs.length} config{configs.length === 1 ? "" : "s"} to pull
				</h3>
				<p class="muted">
					Copy-paste <code>wget</code> commands for every file.
				</p>
			</a>
		</li>
		<li>
			<a class="card" href="/github">
				<h3>🔀 GitHub activity</h3>
				<p class="muted">Repos and pull requests as they land.</p>
			</a>
		</li>
	</ul>
</BaseLayout>

<style>
	.hero {
		position: relative;
		min-height: min(78vh, 640px);
		display: flex;
		align-items: center;
		background:
			linear-gradient(90deg, transparent 18%, var(--cpr-midnight) 35%),
			radial-gradient(900px 500px at 75% 40%, rgba(31, 107, 255, 0.16), transparent 70%),
			url("/brand/hero-tower.jpg") left center / auto 100% no-repeat,
			var(--cpr-midnight);
		border-bottom: 1px solid var(--border);
	}
	.hero-inner {
		width: var(--wide-width);
		max-width: calc(100% - 2rem);
		margin: 0 auto;
		padding: 4rem 0;
		display: flex;
		flex-direction: column;
		align-items: flex-end;
		text-align: right;
	}
	.hero h1 {
		margin: 0.25rem 0 0;
		font-size: clamp(2.2rem, 6vw, 4.2rem);
		line-height: 1.1;
	}
	.tagline {
		font-size: 1.35rem;
		color: var(--cpr-ice-soft);
		margin: 0.5rem 0 1rem;
	}
	.lede {
		max-width: 34rem;
	}
	.ctas {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
		justify-content: flex-end;
	}
	@media (max-width: 720px) {
		.hero {
			background:
				linear-gradient(180deg, rgba(5, 7, 15, 0.55), rgba(5, 7, 15, 0.95) 75%),
				url("/brand/hero-tower.jpg") center top / cover no-repeat;
		}
		.hero-inner {
			align-items: flex-start;
			text-align: left;
		}
		.ctas {
			justify-content: flex-start;
		}
	}
</style>
