---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { getPosts, uniqueTags, slugify } from "../../lib/content";

const posts = await getPosts();
const tags = uniqueTags(posts);
---

<BaseLayout title="Blog" description="News, build logs, OpenWrt guides and security notes." wide>
	<p class="eyebrow">The blog</p>
	<h1>Latest posts</h1>
	<p class="tags">
		{tags.map((t) => (
			<a href={`/blog/tags/${slugify(t)}/`}>#{t}</a>
		))}
	</p>
	<ul class="grid">
		{posts.map((post) => (
			<li>
				<PostCard post={post} />
			</li>
		))}
	</ul>
</BaseLayout>

<style>
	.tags {
		display: flex;
		gap: 0.75rem;
		flex-wrap: wrap;
	}
	h1 {
		margin-top: 0.25rem;
	}
</style>
