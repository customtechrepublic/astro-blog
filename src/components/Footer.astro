---
import { NAV, SITE, SOCIAL } from "../consts";
const year = new Date().getFullYear();
---

<footer>
	<div class="inner">
		<div class="brand">
			<img src="/brand/logo-wordmark.svg" alt={SITE.title} width="220" height="44" />
			<p class="tagline">{SITE.tagline}</p>
		</div>
		<nav aria-label="Footer">
			<ul>
				{NAV.map((item) => (
					<li>
						<a href={item.href}>{item.label}</a>
					</li>
				))}
				<li>
					<a href="/brand">Brand kit</a>
				</li>
			</ul>
		</nav>
		<ul class="social">
			{SOCIAL.map((s) => (
				<li>
					<a href={s.href} rel="me noopener">
						{s.label}
					</a>
				</li>
			))}
			<li>
				<a href={SITE.mainSite}>custompcrepublic.com</a>
			</li>
		</ul>
	</div>
	<p class="copy">
		&copy; {year} {SITE.title}. All rights reserved.
	</p>
</footer>

<style>
	footer {
		margin-top: 4rem;
		border-top: 1px solid var(--border);
		background: var(--surface);
		font-size: 0.9rem;
	}
	.inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 2rem;
		width: var(--wide-width);
		max-width: calc(100% - 2rem);
		margin: 0 auto;
		padding: 2.5rem 0 1rem;
	}
	.brand img {
		border-radius: 0;
	}
	.tagline {
		margin: 0.5rem 0 0;
		color: var(--accent);
		font-weight: 700;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.3rem;
		align-content: start;
	}
	li + li {
		margin: 0;
	}
	a {
		color: var(--text-muted);
		text-decoration: none;
	}
	a:hover {
		color: var(--accent);
	}
	.copy {
		text-align: center;
		color: var(--text-muted);
		padding: 1rem;
		margin: 0;
	}
</style>
