---
import HeaderLink from "./HeaderLink.astro";
import { NAV, SITE, FEATURES } from "../consts";
---

<header>
	<nav aria-label="Main">
		<a class="brand" href="/" aria-label={`${SITE.title} home`}>
			<img src="/brand/logo-mark.svg" alt="" width="36" height="36" />
			<span class="brand-text">
				<span>Custom PC</span>
				<span>Republic</span>
			</span>
		</a>
		<details class="menu">
			<summary aria-label="Menu">☰</summary>
			<ul class="links">
				{NAV.map((item) => (
					<li>
						<HeaderLink href={item.href}>
							{item.label}
							{item.href === "/shop" && !FEATURES.shop && <span class="pill">soon</span>}
						</HeaderLink>
					</li>
				))}
			</ul>
		</details>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		backdrop-filter: blur(12px);
		background: rgba(5, 7, 15, 0.82);
		border-bottom: 1px solid var(--border);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		width: var(--wide-width);
		max-width: calc(100% - 2rem);
		margin: 0 auto;
		min-height: 64px;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
	}
	.brand img {
		border-radius: 0;
	}
	.brand-text {
		display: flex;
		flex-direction: column;
		font-family: var(--font-display);
		font-size: 0.72rem;
		line-height: 1.25;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: #fff;
	}
	.links {
		display: flex;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.links li + li {
		margin: 0;
	}
	.pill {
		margin-left: 0.3rem;
		padding: 0 0.4rem;
		border-radius: 999px;
		font-size: 0.65rem;
		background: var(--surface-2);
		color: var(--cpr-warn);
		vertical-align: middle;
	}
	/* Desktop: menu always open, summary hidden */
	.menu summary {
		display: none;
	}
	@media (min-width: 821px) {
		.menu > .links {
			display: flex !important;
		}
	}
	@media (max-width: 820px) {
		.menu summary {
			display: block;
			cursor: pointer;
			list-style: none;
			font-size: 1.5rem;
			padding: 0.25rem 0.75rem;
			color: var(--accent);
		}
		.menu summary::-webkit-details-marker {
			display: none;
		}
		.menu[open] .links {
			position: absolute;
			right: 1rem;
			top: 64px;
			flex-direction: column;
			padding: 0.75rem;
			border-radius: var(--radius);
			background: var(--surface);
			border: 1px solid var(--border);
			box-shadow: var(--glow);
		}
	}
</style>

<script>
	// Keep the nav permanently open on desktop (details element is the mobile toggle).
	const menu = document.querySelector<HTMLDetailsElement>("header .menu");
	const mq = window.matchMedia("(min-width: 821px)");
	const sync = () => menu && (menu.open = mq.matches);
	sync();
	mq.addEventListener("change", sync);
</script>
