{
	"useTabs": true,
	"printWidth": 110,
	"plugins": ["prettier-plugin-astro"],
	"overrides": [
		{ "files": "*.astro", "options": { "parser": "astro" } },
		{ "files": ["*.md", "*.mdx"], "options": { "useTabs": false, "tabWidth": 2, "proseWrap": "preserve" } },
		{ "files": "*.yml", "options": { "useTabs": false } }
	]
}
