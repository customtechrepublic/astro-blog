// Markdown rules for posts, docs and READMEs. Run: npm run lint:md
{
	"config": {
		"default": true,
		"MD013": false, // line length — prose wraps naturally
		"MD024": { "siblings_only": true },
		"MD025": false, // pages get their H1 from frontmatter `title`
		"MD033": false, // allow inline HTML in MDX
		"MD041": false, // first line is frontmatter, not a heading
	},
	"globs": ["**/*.{md,mdx}"],
	"ignores": ["node_modules", "dist", ".astro", "src/content/docs/**/repos/**"],
}
